<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!-- 与演示程序一致：关闭 4.7.1 之后新增的辅助功能实现，避免 ComboBox 触发
         NonComVisibleBaseClass 托管调试助手（详见 GIS.Display.Demo/App.config）。 -->
    <AppContextSwitchOverrides value="Switch.UseLegacyAccessibilityFeatures=true;Switch.UseLegacyAccessibilityFeatures.2=true;Switch.UseLegacyAccessibilityFeatures.3=true;Switch.UseLegacyAccessibilityFeatures.4=true" />
  </runtime>
</configuration>
