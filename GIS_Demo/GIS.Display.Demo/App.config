<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!--
      关闭 .NET Framework 4.7.1 及之后新增的辅助功能（UI Automation）实现。
      .NET Framework 4.8 中 ComboBox 的 UIA 提供程序 ComboBoxUiaProvider 派生自
      非 COM 可见的 ComboBoxExAccessibleObject，辅助功能客户端查询时会触发
      NonComVisibleBaseClass 托管调试助手（QueryInterface 失败），在调试器下表现为
      “托管调试助手 NonComVisibleBaseClass ...” 弹窗。
      以下 AppContext 开关恢复旧版辅助功能行为，从而避免该 MDA。
    -->
    <AppContextSwitchOverrides value="Switch.UseLegacyAccessibilityFeatures=true;Switch.UseLegacyAccessibilityFeatures.2=true;Switch.UseLegacyAccessibilityFeatures.3=true;Switch.UseLegacyAccessibilityFeatures.4=true" />
  </runtime>
</configuration>
